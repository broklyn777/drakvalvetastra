{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "incremental": false,
    "declaration": false,
    "plugins": []
  },
  "include": ["server/**/*.ts", "packages/**/*.ts"],
  "exclude": ["node_modules", "tests", "src", ".next", "dist"]
}
