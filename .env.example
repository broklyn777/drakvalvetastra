# Node 24+. Start both web and game server with npm run dev.
GAME_SERVER_URL=http://127.0.0.1:4001
GAME_PORT=4001
DATABASE_PATH=.data/drakvalvet.sqlite
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: proxy /socket to the game server, or set a public wss:// URL.
# NEXT_PUBLIC_WS_URL=wss://your-domain.example/socket
# Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
