{
  "name": "drakvalvet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "open": "node scripts/dev-bootstrap.mjs",
    "dev": "concurrently -k -n web,game 'next dev --hostname 0.0.0.0' 'node --watch --import tsx server/index.ts'",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:server": "node --watch --import tsx server/index.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "start:server": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src packages server tests scripts/*.mjs docs/*.md *.ts *.mjs *.json *.md",
    "format:check": "prettier --check src packages server tests scripts/*.mjs docs/*.md *.ts *.mjs *.json *.md",
    "start:web": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
