{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Drakvalvet: starta",
      "type": "npm",
      "script": "open",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "problemMatcher": {
        "owner": "drakvalvet",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*> drakvalvet@.* dev.*$",
          "endsPattern": "^.*Ready in.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
